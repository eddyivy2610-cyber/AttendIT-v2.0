<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Error - Attendit</title>
    <style>
        body { font-family: Arial, sans-serif; display:flex; align-items:center; justify-content:center; min-height:100vh; background:#f5f5f5; }
        .error-box { background:#fff; padding:40px; border-radius:10px; text-align:center; box-shadow:0 2px 20px rgba(0,0,0,0.1); }
        h1 { color:#e74c3c; }
        p { color:#666; margin:10px 0 20px; }
        a { color:#3498db; }
    </style>
</head>
<body>
    <div class="error-box">
        <h1>⚠️ Something went wrong</h1>
        <p><%= message || 'An unexpected error occurred.' %></p>
        <a href="/">← Back to Dashboard</a>
    </div>
</body>
</html>
