<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Attendit | Welcome</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #F4F7FE;
            --panel: #FFFFFF;
            --text: #111827;
            --text-secondary: #4B5563;
            --muted: #9CA3AF;
            --accent-2: #2563eb;
            --border: #E5E7EB;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: 'DM Sans', Arial, sans-serif;
            background: url('https://images.unsplash.com/photo-1499346030926-9a72daac6c63?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80') no-repeat center center fixed;
            background-size: cover;
            color: var(--text);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            position: relative;
        }
        body::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(244, 247, 254, 0.2);
            z-index: 0;
        }
        .container {
            width: 100%;
            max-width: 440px;
            position: relative;
            z-index: 1;
        }
        .card {
            background: rgba(255, 255, 255, 0.65);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.8);
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            padding: 48px 40px;
            display: flex;
            flex-direction: column;
        }
        .logo-container {
            text-align: center;
            margin-bottom: 24px;
            color: var(--accent-2);
            font-size: 1.5rem;
            font-weight: 700;
            font-family: 'Sora', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        .logo-container ion-icon {
            font-size: 1.8rem;
        }
        h1 { 
            margin: 0 0 32px; 
            font-size: 1.4rem; 
            text-align: center; 
            color: var(--text); 
            font-weight: 600; 
            font-family: 'Sora', sans-serif;
        }
        .alert {
            padding: 12px 14px;
            border-radius: 8px;
            font-size: 0.9rem;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .alert-error { background: #FEF2F2; color: #991B1B; border: 1px solid #FECACA; }
        
        .form-group { display: flex; flex-direction: column; gap: 8px; margin-bottom: 20px; }
        label { font-weight: 600; font-size: 0.85rem; color: var(--text-secondary); }
        
        input {
            width: 100%;
            border: 1px solid var(--border);
            background: #FFFFFF;
            color: var(--text);
            border-radius: 8px;
            padding: 12px 16px;
            font-size: 0.95rem;
            outline: none;
            transition: border-color 0.2s;
        }
        input::placeholder { color: #D1D5DB; }
        input:focus { border-color: var(--accent-2); box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1); }
        
        .input-with-icon { position: relative; }
        .input-icon {
            position: absolute;
            right: 16px; top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: var(--muted);
        }
        
        .remember-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 32px;
            font-size: 0.85rem;
        }
        .remember-row label { display: flex; align-items: center; gap: 6px; cursor: pointer; color: var(--text-secondary); font-weight: 500; }
        .remember-row a { color: var(--accent-2); text-decoration: none; font-weight: 500; }
        
        button.primary {
            width: 100%;
            border: 0;
            border-radius: 8px;
            padding: 14px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: background-color 0.2s;
            background: var(--accent-2); 
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
        }
        button.primary:hover { background: #1D4ED8; }
        
        .toggle-text {
            text-align: center;
            margin-top: 24px;
            font-size: 0.9rem;
            color: var(--text-secondary);
        }
        .toggle-text a {
            color: var(--accent-2);
            text-decoration: none;
            font-weight: 600;
            cursor: pointer;
        }
        
        .form { display: none; }
        .form.active { display: block; }
        
        @media (max-width: 480px) {
            .card { padding: 32px 24px; }
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="card">
            <div class="logo-container">
                <img src="/assets/images/logo.png" alt="AttendIT Logo" style="max-height: 60px; width: auto;">
            </div>

            <!-- Login Form -->
            <div class="form active" id="loginForm">
                <h1>Sign in to attendit</h1>

                <% if (error) { %>
                    <div class="alert alert-error">
                        <ion-icon name="alert-circle-outline"></ion-icon> <%= error %>
                    </div>
                <% } %>

                <form method="POST" action="/login">
                    <div class="form-group">
                        <label for="user_email">Email Address</label>
                        <input type="email" id="user_email" name="user_email" placeholder="Enter your email" value="<%= prefillEmail %>" required>
                    </div>

                    <div class="form-group">
                        <label for="password">Password</label>
                        <div class="input-with-icon">
                            <input type="password" id="password" name="password" placeholder="Enter your password" required>
                            <span class="input-icon" onclick="togglePassword('password')">
                                <ion-icon name="eye-outline"></ion-icon>
                            </span>
                        </div>
                    </div>

                    <div class="remember-row">
                        <label><input type="checkbox" name="remember"> Remember me</label>
                        <a href="#">Forgot Password?</a>
                    </div>

                    <button type="submit" class="primary">Sign In</button>
                </form>

                <div class="toggle-text">
                    Don't have an account? <a onclick="showForm('register')">Register here</a>
                </div>
            </div>

            <!-- Registration Form (for student self-registration) -->
            <div class="form" id="registerForm">
                <h1>Student Registration</h1>

                <div class="alert alert-error" style="background: #EFF6FF; color: #1D4ED8; border-color: #BFDBFE;">
                    <ion-icon name="information-circle-outline"></ion-icon>
                    Student registration requires a link from your admin. Contact your supervisor.
                </div>

                <div class="toggle-text">
                    Already have an account? <a onclick="showForm('login')">Sign in here</a>
                </div>
            </div>
        </div>
    </div>

    <script>
        function showForm(formType) {
            document.querySelectorAll('.form').forEach(form => form.classList.remove('active'));
            document.getElementById(formType + 'Form').classList.add('active');
        }

        function togglePassword(inputId) {
            const input = document.getElementById(inputId);
            const icon = input.parentNode.querySelector('ion-icon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.name = 'eye-off-outline';
            } else {
                input.type = 'password';
                icon.name = 'eye-outline';
            }
        }
    </script>

    <script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
</body>
</html>
