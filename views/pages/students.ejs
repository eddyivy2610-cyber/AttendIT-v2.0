<style>
.day-pill { padding: 6px 12px; border-radius: 999px; border: 1px solid var(--border); background: var(--panel-2); color: var(--muted); cursor: pointer; font-size: 0.85rem; transition: all 0.2s; user-select: none; }
.day-pill.active { background: var(--accent-2); color: white; border-color: var(--accent-2); }
.pill-group { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
</style>
<div id="students-page" class="page-content">
    <div class="content">
        <div class="filter-section">
            <div class="filter-actions">
                <div class="year-pagination">
                    <button class="year-btn active">2026</button>
                    <button class="year-btn">2025</button>
                    <button class="year-btn">2024</button>
                    <button class="year-btn">2023</button>
                    <button class="year-btn">2022</button>
                    <button class="year-btn">2021</button>
                </div>
                <div class="search-box">
                    <input type="text" placeholder="Search students..." class="search-input" id="student-search">
                    <i class="fas fa-search search-icon"></i>
                </div>
                <div class="action-buttons">
                    <button class="export-btn" onclick="showAddStudentModal()">
                        <i class="fa-solid fa-user-plus"></i> Add Student
                    </button>
                    <button class="export-btn">
                        <i class="fas fa-download"></i> Export
                    </button>
                </div>
            </div>
        </div>

        <% if (pendingStudents && pendingStudents.length > 0) { %>
            <div class="students-table-container" style="margin-bottom: 16px;">
                <div style="padding: 14px 16px; border-bottom: 1px solid var(--hover-color); display:flex; justify-content:space-between; align-items:center; gap: 12px;">
                    <div>
                        <h3 style="margin:0 0 4px;">Pending Student Submissions</h3>
                        <small style="color:var(--black2);">Review and approve public QR submissions before they become active.</small>
                    </div>
                    <span style="padding: 6px 10px; border-radius: 999px; background: rgba(37, 99, 235, 0.1); color: var(--primary); font-weight: 700;"><%= pendingStudents.length %> pending</span>
                </div>
                <div style="overflow-x:auto;">
                    <table class="students-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Institution</th>
                                <th>Course</th>
                                <th>Submitted</th>
                                <th class="actions-header">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% pendingStudents.forEach(student => { %>
                                <tr>
                                    <td><%= student.student_name %></td>
                                    <td><%= student.email %></td>
                                    <td><%= student.institution ? student.institution.institution_name : '--' %></td>
                                    <td><%= student.course_of_study || '--' %></td>
                                    <td><%= student.created_at ? new Date(student.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '--' %></td>
                                    <td>
                                        <div class="action-buttons side">
                                            <button class="action-btn approve-btn" onclick="approveStudent('<%= student._id %>')" data-tooltip="Approve Student">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        <% } %>

        <!-- Students Table -->
        <div class="students-table-container">
            <table class="students-table">
                <thead>
                    <tr>
                        <th class="sortable" data-sort="sn">S/N</th>
                        <th class="sortable" data-sort="image"><i class="fas fa-image"></i></th>
                        <th class="sortable" data-sort="name">Name</th>
                        <th class="sortable" data-sort="gender">Gender</th>
                        <th class="sortable" data-sort="course">Department</th>
                        <th class="sortable" data-sort="school">School</th>
                        <th class="sortable" data-sort="skill">Skill Interest</th>
                        <th class="sortable" data-sort="start">Start Date</th>
                        <th class="sortable" data-sort="end">End Date</th>
                        <th class="actions-header">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (students && students.length > 0) { %>
                        <% 
                        const groupedStudents = {};
                        students.forEach(s => {
                            const batch = s.days_of_week_batch || 'Unassigned Batch';
                            if (!groupedStudents[batch]) groupedStudents[batch] = [];
                            groupedStudents[batch].push(s);
                        });
                        
                        let globalIndex = 1;
                        for (const [batchName, batchStudents] of Object.entries(groupedStudents)) { 
                        %>
                            <tr class="group-header-row">
                                <td colspan="10" style="background-color: rgba(37, 99, 235, 0.1); font-weight: bold; padding: 12px 15px; color: var(--text);">
                                    <i class="fas fa-layer-group" style="color: var(--accent-2); margin-right: 8px;"></i> Batch: <%= batchName %> (<%= batchStudents.length %> students)
                                </td>
                            </tr>
                            <% batchStudents.forEach((student) => { %>
                                <% const isExpired = student.end_date && new Date(student.end_date) < new Date(); %>
                                <tr class="student-row" data-student-id="<%= student._id %>">
                                    <td><%= globalIndex++ %></td>
                                <td>
                                    <img src="<%= student.photo_url ? '/' + student.photo_url : 'https://picsum.photos/seed/' + encodeURIComponent(student.student_name) + '/40/40.jpg' %>"
                                         alt="<%= student.student_name %>"
                                         class="student-photo"
                                         onclick="viewStudentReport('<%= student._id %>')">
                                </td>
                                <td class="student-name" onclick="viewStudentReport('<%= student._id %>')">
                                    <%= student.student_name %>
                                </td>
                                <td><%= student.gender || 'N/A' %></td>
                                <td><%= student.course_of_study || '--' %></td>
                                <td><%= student.institution ? student.institution.institution_name : '--' %></td>
                                <td>
                                    <div class="skill-interest">
                                        <span class="skill-text"><%= student.skill_of_interest || 'Not specified' %></span>
                                    </div>
                                </td>
                                <td><%= student.join_date ? new Date(student.join_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '--' %></td>
                                <td>
                                    <div class="end-date <%= isExpired ? 'expired' : '' %>">
                                        <%= student.end_date ? new Date(student.end_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '--' %>
                                    </div>
                                </td>
                                <td>
                                    <div class="action-buttons side">
                                        <button class="action-btn edit-btn"
                                                onclick="editStudent('<%= student._id %>')"
                                                data-tooltip="Edit Student">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <% const sBatch = student.days_of_week_batch || ''; %>
                                        <button class="action-btn" style="color: var(--accent-2); border: 1px solid var(--border);"
                                                onclick="openRegroupModal('<%= student._id %>', '<%= sBatch %>')"
                                                data-tooltip="Change Batch">
                                            <i class="fas fa-layer-group"></i>
                                        </button>
                                        <button class="action-btn delete-btn"
                                                onclick="deleteStudent('<%= student._id %>')"
                                                data-tooltip="Delete Student">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                        <% } %>
                    <% } else { %>
                        <tr>
                            <td colspan="10" style="text-align: center; padding: 20px;">
                                <div class="no-students">
                                    <i class="fas fa-user-graduate" style="font-size: 2rem; color: #ccc; margin-bottom: 10px;"></i>
                                    <p>No students found. Please add some students to get started.</p>
                                </div>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <div class="table-pagination">
            <div class="pagination-info">
                Showing <span class="start-record">1</span> to
                <span class="end-record"><%= students ? students.length : 0 %></span> of
                <span class="total-records"><%= students ? students.length : 0 %></span> students
            </div>
            <div class="pagination-controls">
                <button class="pagination-btn" disabled><i class="fas fa-chevron-left"></i></button>
                <button class="pagination-btn active">1</button>
                <button class="pagination-btn"><i class="fas fa-chevron-right"></i></button>
            </div>
        </div>
    </div>
</div>

<!-- Add Student Modal -->
<div id="addStudentModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Add New Student</h3>
            <span class="close" onclick="closeAddStudentModal()">&times;</span>
        </div>
        <div id="modal-alert" style="display:none; padding: 10px 20px;"></div>
        <div class="modal-body">
            <form id="addStudentForm" enctype="multipart/form-data">
                <div class="form-row">
                    <div class="form-group">
                        <label for="student_name">Full Name *</label>
                        <input type="text" id="student_name" name="student_name" placeholder="Enter full name" required>
                    </div>
                    <div class="form-group">
                        <label for="email">Email *</label>
                        <input type="email" id="email" name="email" placeholder="Enter email address" required>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="phone">Phone</label>
                        <input type="tel" id="phone" name="phone" placeholder="+2348012345678" required>
                    </div>
                    <div class="form-group">
                        <label for="gender">Gender *</label>
                        <select id="gender" name="gender" required>
                            <option value="">Select gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="course_of_study">Course of Study *</label>
                        <input type="text" id="course_of_study" name="course_of_study" placeholder="e.g., Computer Science" required>
                    </div>
                    <div class="form-group">
                        <label for="institution_id">Institution *</label>
                        <select name="institution_id" id="institution_id" required>
                            <option value="">Select Institution</option>
                            <% if (institutions && institutions.length > 0) { %>
                                <% institutions.forEach(inst => { %>
                                    <option value="<%= inst._id %>"><%= inst.institution_name %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="skill_of_interest">Skill Interest</label>
                        <input type="text" id="skill_of_interest" name="skill_of_interest" placeholder="e.g., Web Development, Data Analysis">
                    </div>
                    <div class="form-group">
                        <label for="period_of_attachment">Period of Attachment (months)</label>
                        <input type="number" id="period_of_attachment" name="period_of_attachment" value="6" placeholder="e.g., 6" min="1" max="24">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group" style="grid-column: 1 / -1;">
                        <label>Days of Week Batch</label>
                        <input type="hidden" id="days_of_week_batch" name="days_of_week_batch" value="">
                        <div class="pill-group" id="days-pills">
                            <div class="day-pill" data-day="Monday">Monday</div>
                            <div class="day-pill" data-day="Tuesday">Tuesday</div>
                            <div class="day-pill" data-day="Wednesday">Wednesday</div>
                            <div class="day-pill" data-day="Thursday">Thursday</div>
                            <div class="day-pill" data-day="Friday">Friday</div>
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="passport_image">Passport Photo</label>
                        <div class="image-upload" id="imageUpload">
                            <input type="file" id="passport_image" name="photo" accept="image/*">
                            <ion-icon name="cloud-upload-outline" class="image-upload-icon"></ion-icon>
                            <div class="image-upload-text">
                                <strong>Click to upload</strong> or drag and drop<br>
                                <small>JPG, PNG, GIF (Max 5MB)</small>
                            </div>
                        </div>
                        <img id="imagePreview" class="image-preview" alt="Passport Preview" style="display:none; max-width:100px; margin-top:8px;">
                    </div>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn-secondary" onclick="closeAddStudentModal()">Cancel</button>
            <button type="button" class="btn-primary" id="submitBtn" onclick="saveStudent()">Save Student</button>
        </div>
    </div>
</div>

<!-- Regroup Student Modal -->
<div id="regroupModal" class="modal">
    <div class="modal-content" style="max-width: 400px;">
        <div class="modal-header">
            <h3>Change Student Batch</h3>
            <span class="close" onclick="closeRegroupModal()">&times;</span>
        </div>
        <div id="regroup-modal-alert" style="display:none; padding: 10px 20px;"></div>
        <div class="modal-body">
            <input type="hidden" id="regroup_student_id">
            <input type="hidden" id="regroup_days_batch">
            <div class="pill-group" id="regroup-days-pills" style="justify-content: center; margin-bottom: 20px;">
                <div class="day-pill" data-day="Monday">Monday</div>
                <div class="day-pill" data-day="Tuesday">Tuesday</div>
                <div class="day-pill" data-day="Wednesday">Wednesday</div>
                <div class="day-pill" data-day="Thursday">Thursday</div>
                <div class="day-pill" data-day="Friday">Friday</div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-secondary" onclick="closeRegroupModal()">Cancel</button>
            <button type="button" class="btn-primary" id="regroupBtn" onclick="saveRegroup()">Save Changes</button>
        </div>
    </div>
</div>

<script>
// Add Student Pill Logic
document.addEventListener('DOMContentLoaded', () => {
    setupPills('days-pills', 'days_of_week_batch');
    setupPills('regroup-days-pills', 'regroup_days_batch');
});

function setupPills(containerId, inputId) {
    const container = document.getElementById(containerId);
    if(!container) return;
    const pills = container.querySelectorAll('.day-pill');
    const hiddenInput = document.getElementById(inputId);
    
    pills.forEach(pill => {
        pill.addEventListener('click', () => {
            let selectedDays = hiddenInput.value ? hiddenInput.value.split(',').map(d => d.trim()).filter(d=>d) : [];
            const day = pill.dataset.day;
            if (selectedDays.includes(day)) {
                selectedDays = selectedDays.filter(d => d !== day);
                pill.classList.remove('active');
            } else {
                selectedDays.push(day);
                pill.classList.add('active');
            }
            const allDays = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'];
            selectedDays.sort((a, b) => allDays.indexOf(a) - allDays.indexOf(b));
            hiddenInput.value = selectedDays.join(', ');
        });
    });
}

function openRegroupModal(studentId, currentBatch) {
    document.getElementById('regroup_student_id').value = studentId;
    const hiddenInput = document.getElementById('regroup_days_batch');
    hiddenInput.value = currentBatch || '';
    
    const pills = document.getElementById('regroup-days-pills').querySelectorAll('.day-pill');
    let selectedDays = currentBatch ? currentBatch.split(',').map(d => d.trim()) : [];
    pills.forEach(pill => {
        if (selectedDays.includes(pill.dataset.day)) pill.classList.add('active');
        else pill.classList.remove('active');
    });
    
    document.getElementById('regroupModal').style.display = 'block';
}

function closeRegroupModal() {
    document.getElementById('regroupModal').style.display = 'none';
}

async function saveRegroup() {
    const studentId = document.getElementById('regroup_student_id').value;
    const newBatch = document.getElementById('regroup_days_batch').value;
    const btn = document.getElementById('regroupBtn');
    
    btn.disabled = true;
    btn.textContent = 'Saving...';
    
    try {
        const response = await fetch('/api/students/' + studentId, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ days_of_week_batch: newBatch })
        });
        const result = await response.json();
        if (result.success) {
            showNotification('Batch updated successfully!', 'success');
            setTimeout(() => location.reload(), 800);
        } else {
            showNotification(result.message || 'Update failed', 'error');
            btn.disabled = false;
            btn.textContent = 'Save Changes';
        }
    } catch (err) {
        showNotification('Network error.', 'error');
        btn.disabled = false;
        btn.textContent = 'Save Changes';
    }
}

// Students page — all API calls now go to /api/students
function viewStudentReport(studentId) {
    window.location.href = '/?page=reports&student_id=' + studentId;
}

function showAddStudentModal() {
    document.getElementById('addStudentModal').style.display = 'block';
}

function closeAddStudentModal() {
    document.getElementById('addStudentModal').style.display = 'none';
    document.getElementById('addStudentForm').reset();
    document.getElementById('imagePreview').style.display = 'none';
    document.getElementById('modal-alert').style.display = 'none';
}

async function saveStudent() {
    const form = document.getElementById('addStudentForm');
    const submitBtn = document.getElementById('submitBtn');
    const alertBox = document.getElementById('modal-alert');

    const requiredFields = form.querySelectorAll('[required]');
    let valid = true;
    requiredFields.forEach(field => {
        if (!field.value.trim()) { valid = false; field.style.borderColor = 'var(--danger, #e74c3c)'; }
        else { field.style.borderColor = ''; }
    });

    if (!valid) {
        alertBox.style.display = 'block';
        alertBox.style.color = '#e74c3c';
        alertBox.textContent = 'Please fill in all required fields.';
        return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Saving...';
    alertBox.style.display = 'none';

    try {
        const formData = new FormData(form);
        const response = await fetch('/api/students', { method: 'POST', body: formData });
        const result = await response.json();

        if (result.success) {
            closeAddStudentModal();
            showNotification('Student registered successfully!', 'success');
            setTimeout(() => location.reload(), 1000);
        } else {
            alertBox.style.display = 'block';
            alertBox.style.color = '#e74c3c';
            alertBox.textContent = result.message || 'Failed to add student.';
        }
    } catch (err) {
        alertBox.style.display = 'block';
        alertBox.textContent = 'Network error. Please try again.';
    }

    submitBtn.disabled = false;
    submitBtn.textContent = 'Save Student';
}

async function deleteStudent(studentId) {
    event.stopPropagation();
    if (!confirm('Are you sure you want to delete this student? This cannot be undone.')) return;

    try {
        const response = await fetch('/api/students/' + studentId, { method: 'DELETE' });
        const result = await response.json();
        if (result.success) {
            const row = document.querySelector(`tr[data-student-id="${studentId}"]`);
            if (row) { row.style.opacity = '0.4'; setTimeout(() => { row.remove(); }, 400); }
            showNotification('Student deleted successfully!', 'success');
        } else {
            showNotification(result.message || 'Delete failed.', 'error');
        }
    } catch (err) {
        showNotification('Network error.', 'error');
    }
}

async function approveStudent(studentId) {
    if (!confirm('Approve this student and make them active?')) return;

    try {
        const response = await fetch('/api/students/' + studentId + '/approve', { method: 'POST' });
        const result = await response.json();
        if (result.success) {
            showNotification('Student approved successfully!', 'success');
            setTimeout(() => location.reload(), 800);
        } else {
            showNotification(result.message || 'Approval failed.', 'error');
        }
    } catch (err) {
        showNotification('Network error.', 'error');
    }
}

function editStudent(studentId) {
    event.stopPropagation();
    showNotification('Edit functionality — coming soon!', 'info');
}

// Search
document.getElementById('student-search').addEventListener('input', function(e) {
    const term = e.target.value.toLowerCase();
    document.querySelectorAll('.student-row').forEach(row => {
        const name = row.querySelector('.student-name')?.textContent.toLowerCase() || '';
        const cells = row.cells;
        const course = cells[4]?.textContent.toLowerCase() || '';
        const school = cells[5]?.textContent.toLowerCase() || '';
        const skill = row.querySelector('.skill-text')?.textContent.toLowerCase() || '';
        row.style.display = (name.includes(term) || course.includes(term) || school.includes(term) || skill.includes(term)) ? '' : 'none';
    });
});

// Image preview
document.getElementById('passport_image').addEventListener('change', function(e) {
    if (e.target.files && e.target.files[0]) {
        const reader = new FileReader();
        reader.onload = function(ev) {
            const preview = document.getElementById('imagePreview');
            preview.src = ev.target.result;
            preview.style.display = 'block';
        };
        reader.readAsDataURL(e.target.files[0]);
    }
});

// Close modal on outside click
window.addEventListener('click', function(e) {
    const modal = document.getElementById('addStudentModal');
    if (e.target === modal) closeAddStudentModal();
});

window.viewStudentReport = viewStudentReport;
window.showAddStudentModal = showAddStudentModal;
window.closeAddStudentModal = closeAddStudentModal;
window.saveStudent = saveStudent;
window.editStudent = editStudent;
window.deleteStudent = deleteStudent;
window.approveStudent = approveStudent;
window.openRegroupModal = openRegroupModal;
window.closeRegroupModal = closeRegroupModal;
window.saveRegroup = saveRegroup;
</script>
