<div id="dashboard-page" class="page-content">
    <!-- Dashboard Cards Grid (E-ID CARD Style) -->
    <div class="dashboard-cards-new">
        <!-- Card 1: Total Students -->
        <div class="stat-card">
            <div class="stat-icon icon-blue">
                <ion-icon name="people-outline"></ion-icon>
            </div>
            <div class="stat-details">
                <p class="stat-title">Total Students</p>
                <span class="stat-value" id="total-students"><%= totalStudents %></span>
            </div>
        </div>

        <!-- Card 2: Attendance Rate -->
        <div class="stat-card">
            <div class="stat-icon icon-orange">
                <ion-icon name="calendar-outline"></ion-icon>
            </div>
            <div class="stat-details">
                <p class="stat-title">Attendance Rate</p>
                <span class="stat-value" id="attendance-rate"><%= attendanceRate %>%</span>
            </div>
        </div>

        <!-- Card 3: Active Projects -->
        <div class="stat-card">
            <div class="stat-icon icon-green">
                <ion-icon name="folder-open-outline"></ion-icon>
            </div>
            <div class="stat-details">
                <p class="stat-title">Active Projects</p>
                <span class="stat-value" id="active-projects">-</span>
            </div>
        </div>

        <!-- Card 4: Active Students -->
        <div class="stat-card">
            <div class="stat-icon icon-cyan">
                <ion-icon name="person-check-outline"></ion-icon>
            </div>
            <div class="stat-details">
                <p class="stat-title">Active Students</p>
                <span class="stat-value" id="active-students"><%= activeStudents %></span>
            </div>
        </div>
    </div>

    <!-- Sleek Quick Actions Section (Compact) -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 32px; margin-top: 16px;">
        <!-- Action 1: Attendance -->
        <a href="/?page=attendance" style="text-decoration: none; display: block; border-radius: 12px; background: linear-gradient(135deg, #4F46E5 0%, #6366F1 100%); padding: 1.5px; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 8px 16px -6px rgba(99, 102, 241, 0.4)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none'">
            <div style="background: var(--white); border-radius: 10.5px; padding: 12px 16px; height: 100%; display: flex; align-items: center; gap: 12px;">
                <div style="width: 36px; height: 36px; border-radius: 8px; background: #EEF2FF; color: #4F46E5; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0;">
                    <ion-icon name="checkmark-circle-outline"></ion-icon>
                </div>
                <div>
                    <h4 style="margin: 0 0 2px 0; font-size: 14px; font-weight: 600; color: var(--black1);">Mark Attendance</h4>
                    <p style="margin: 0; font-size: 11px; color: var(--black2);">Manage daily check-ins</p>
                </div>
                <div style="margin-left: auto; color: var(--black2);">
                    <ion-icon name="chevron-forward-outline" style="font-size: 14px;"></ion-icon>
                </div>
            </div>
        </a>

        <!-- Action 2: Reports -->
        <a href="/?page=reports" style="text-decoration: none; display: block; border-radius: 12px; background: linear-gradient(135deg, #059669 0%, #10B981 100%); padding: 1.5px; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 8px 16px -6px rgba(16, 185, 129, 0.4)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none'">
            <div style="background: var(--white); border-radius: 10.5px; padding: 12px 16px; height: 100%; display: flex; align-items: center; gap: 12px;">
                <div style="width: 36px; height: 36px; border-radius: 8px; background: #ECFDF5; color: #059669; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0;">
                    <ion-icon name="stats-chart-outline"></ion-icon>
                </div>
                <div>
                    <h4 style="margin: 0 0 2px 0; font-size: 14px; font-weight: 600; color: var(--black1);">View Reports</h4>
                    <p style="margin: 0; font-size: 11px; color: var(--black2);">Analyze core metrics</p>
                </div>
                <div style="margin-left: auto; color: var(--black2);">
                    <ion-icon name="chevron-forward-outline" style="font-size: 14px;"></ion-icon>
                </div>
            </div>
        </a>

        <!-- Action 3: Students -->
        <a href="/?page=students" style="text-decoration: none; display: block; border-radius: 12px; background: linear-gradient(135deg, #D97706 0%, #F59E0B 100%); padding: 1.5px; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 8px 16px -6px rgba(245, 158, 11, 0.4)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none'">
            <div style="background: var(--white); border-radius: 10.5px; padding: 12px 16px; height: 100%; display: flex; align-items: center; gap: 12px;">
                <div style="width: 36px; height: 36px; border-radius: 8px; background: #FFFBEB; color: #D97706; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0;">
                    <ion-icon name="people-outline"></ion-icon>
                </div>
                <div>
                    <h4 style="margin: 0 0 2px 0; font-size: 14px; font-weight: 600; color: var(--black1);">Manage Students</h4>
                    <p style="margin: 0; font-size: 11px; color: var(--black2);">View directories</p>
                </div>
                <div style="margin-left: auto; color: var(--black2);">
                    <ion-icon name="chevron-forward-outline" style="font-size: 14px;"></ion-icon>
                </div>
            </div>
        </a>
    </div>

    <!-- Main Content Area -->
    <div class="dashboard-details">
        <!-- Recently Added Students -->
        <div class="detail-card recent-students">
            <div class="detail-header">
                <h3>Recently Added Students</h3>
                <a href="/?page=students" class="btn btn-primary">View All</a>
            </div>

            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Gender</th>
                            <th>POA</th>
                            <th>Joined On</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (recentStudents && recentStudents.length > 0) { %>
                            <% recentStudents.forEach(student => { %>
                                <tr>
                                    <td>
                                        <div class="student-info">
                                            <div class="student-avatar">
                                                <img src="https://picsum.photos/seed/<%= encodeURIComponent(student.student_name) %>/40/40" alt="<%= student.student_name %>">
                                            </div>
                                            <span class="student-name"><%= student.student_name %></span>
                                        </div>
                                    </td>
                                    <td><%= student.gender || '--' %></td>
                                    <td><%= student.period_of_attachment ? student.period_of_attachment + ' months' : '--' %></td>
                                    <td><%= student.created_at ? new Date(student.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '--' %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr class="empty-row">
                                <td colspan="4">
                                    <div class="empty-state">
                                        <ion-icon name="person-add-outline"></ion-icon>
                                        <p>No recently added students</p>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Institution Overview -->
        <div class="detail-card institution-overview">
            <div class="detail-header">
                <h3>Institution Overview</h3>
            </div>

            <div class="institution-list">
                <% if (institutions && institutions.length > 0) { %>
                    <% institutions.forEach(inst => { %>
                        <div class="institution-item">
                            <div class="institution-logo">
                                <img src="https://picsum.photos/seed/<%= encodeURIComponent(inst.institution_name) %>/60/60" alt="<%= inst.institution_name %>">
                            </div>
                            <div class="institution-details">
                                <h4><%= inst.institution_name %></h4>
                                <div class="institution-stats">
                                    <span class="stat">
                                        <ion-icon name="people-outline"></ion-icon>
                                        <%= inst.student_count %> Registered
                                    </span>
                                    <span class="stat">
                                        <ion-icon name="checkmark-circle-outline"></ion-icon>
                                        <%= inst.active_count || inst.student_count %> Active
                                    </span>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="empty-state">
                        <ion-icon name="business-outline"></ion-icon>
                        <p>No institutions found</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>
