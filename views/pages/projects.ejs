<div id="projects-page" class="page-content" style="padding: 24px; display: flex; flex-direction: column; height: 100%;">
    <div class="projects-container" style="max-width: 1200px; margin: 0 auto; width: 100%; display: flex; flex-direction: column; height: 100%;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
            <h2 style="margin: 0; font-size: 24px; font-weight: 600; color: #111827;">Projects Overview</h2>
            
            <div style="display: flex; align-items: center; gap: 12px;">
                <div class="search-box-new" style="display: flex; align-items: center; gap: 8px; background-color: #ffffff; border: 1px solid #EAECF0; border-radius: 8px; padding: 8px 12px; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);">
                    <ion-icon name="search-outline" style="color: #9BA7B0; font-size: 16px;"></ion-icon>
                    <input type="text" placeholder="Search projects..." id="projectSearch" style="border: none; outline: none; font-size: 13px; width: 200px; font-family: 'DM Sans', sans-serif;">
                </div>
                <button class="btn-primary" style="background-color: #0052FF; border-radius: 8px; font-family: 'DM Sans', sans-serif; display: flex; align-items: center; gap: 8px; padding: 8px 16px; border: none; color: white; cursor: pointer; font-size: 13px; font-weight: 500; transition: all 0.2s;" onclick="showAddProjectModal()">
                    <ion-icon name="add-outline" style="font-size: 16px;"></ion-icon> Add Project
                </button>
            </div>
        </div>

        <div class="projects-table-card" style="background-color: #ffffff; border: 1px solid rgba(234, 236, 240, 0.8); border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02); display: flex; flex-direction: column; flex: 1;">
            <div style="overflow-x: auto; flex: 1;">
                <table class="projects-table" style="width: 100%; border-collapse: collapse; text-align: left;" id="projects-tbody">
                    <thead style="background-color: #F8FAFC; border-bottom: 1px solid #EAECF0; position: sticky; top: 0; z-index: 10;">
                        <tr>
                            <th style="font-weight: 600; color: #6E7C87; font-size: 13px; padding: 12px 16px;">Project Title</th>
                            <th style="font-weight: 600; color: #6E7C87; font-size: 13px; padding: 12px 16px;">Student(s)</th>
                            <th style="font-weight: 600; color: #6E7C87; font-size: 13px; padding: 12px 16px;">Supervised By</th>
                            <th style="font-weight: 600; color: #6E7C87; font-size: 13px; padding: 12px 16px;">Tech Stack</th>
                            <th style="font-weight: 600; color: #6E7C87; font-size: 13px; padding: 12px 16px;">Dates</th>
                            <th style="font-weight: 600; color: #6E7C87; font-size: 13px; padding: 12px 16px;">Status</th>
                            <th style="font-weight: 600; color: #6E7C87; font-size: 13px; padding: 12px 16px; text-align: center;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (projects && projects.length > 0) { %>
                            <% projects.forEach(project => { %>
                                <% 
                                const isCompleted = project.status === 'Completed';
                                const isOverdue = !isCompleted && new Date(project.due_date) < new Date();
                                %>
                                <tr data-project-id="<%= project._id %>" style="border-bottom: 1px solid #EAECF0; transition: background-color 0.2s; <%= isCompleted ? 'background-color: #F8FAFC;' : 'hover:bg-[#F8FAFC]/50' %>">
                                    <td style="padding: 12px 16px;">
                                        <div style="font-weight: 600; color: #111827; font-size: 14px;" class="project-title"><%= project.project_name %></div>
                                        <% if(project.description) { %>
                                            <div style="font-size: 12px; color: #64748B; margin-top: 4px; max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= project.description %>"><%= project.description %></div>
                                        <% } %>
                                    </td>
                                    <td class="student-cell" style="padding: 12px 16px; font-size: 13px; color: #4A5568;"><%= project.students %></td>
                                    <td class="supervisor-cell" style="padding: 12px 16px; font-size: 13px; color: #64748B;"><%= project.supervisor %></td>
                                    <td style="padding: 12px 16px;">
                                        <span class="tech-stack" style="display: inline-flex; align-items: center; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 500; background-color: #F1F5F9; color: #475569; border: 1px solid #E2E8F0;"><%= project.technology_stack %></span>
                                    </td>
                                    <td style="padding: 12px 16px; font-size: 12px;">
                                        <div style="color: #64748B;">Start: <%= new Date(project.start_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></div>
                                        <div style="color: <%= isOverdue ? '#EF4444' : '#111827' %>; font-weight: 500; margin-top: 2px;">Due: <%= new Date(project.due_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></div>
                                    </td>
                                    <td style="padding: 12px 16px;">
                                        <% if(isCompleted) { %>
                                            <span style="display: inline-flex; align-items: center; padding: 2px 10px; border-radius: 9999px; font-size: 12px; font-weight: 500; background-color: #DCFCE7; color: #166534;">Completed</span>
                                        <% } else if(isOverdue) { %>
                                            <span style="display: inline-flex; align-items: center; padding: 2px 10px; border-radius: 9999px; font-size: 12px; font-weight: 500; background-color: #FEE2E2; color: #991B1B;">Overdue</span>
                                        <% } else { %>
                                            <span style="display: inline-flex; align-items: center; padding: 2px 10px; border-radius: 9999px; font-size: 12px; font-weight: 500; background-color: #FEF3C7; color: #92400E;">In Progress</span>
                                        <% } %>
                                    </td>
                                    <td style="padding: 12px 16px; text-align: center;">
                                        <div style="display: flex; gap: 8px; justify-content: center;">
                                            <% if (project.repository_url) { %>
                                                <a href="<%= project.repository_url %>" target="_blank" title="View Source" style="color: #64748B; font-size: 18px; transition: color 0.2s;" onmouseover="this.style.color='#111827'" onmouseout="this.style.color='#64748B'">
                                                    <ion-icon name="logo-github"></ion-icon>
                                                </a>
                                            <% } %>
                                            <% if (!isCompleted) { %>
                                                <button onclick="markComplete('<%= project._id %>')" title="Mark Complete" style="background: none; border: none; cursor: pointer; color: #10B981; font-size: 18px; transition: color 0.2s;" onmouseover="this.style.color='#059669'" onmouseout="this.style.color='#10B981'">
                                                    <ion-icon name="checkmark-circle-outline"></ion-icon>
                                                </button>
                                            <% } %>
                                            <button onclick="editProject('<%= project._id %>')" title="Edit" style="background: none; border: none; cursor: pointer; color: #6366F1; font-size: 18px; transition: color 0.2s;" onmouseover="this.style.color='#4F46E5'" onmouseout="this.style.color='#6366F1'">
                                                <ion-icon name="create-outline"></ion-icon>
                                            </button>
                                            <button onclick="deleteProject('<%= project._id %>')" title="Delete" style="background: none; border: none; cursor: pointer; color: #EF4444; font-size: 18px; transition: color 0.2s;" onmouseover="this.style.color='#DC2626'" onmouseout="this.style.color='#EF4444'">
                                                <ion-icon name="trash-outline"></ion-icon>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" style="text-align: center; padding: 48px 16px;">
                                    <div style="display: flex; flex-direction: column; align-items: center; color: #94A3B8;">
                                        <ion-icon name="folder-open-outline" style="font-size: 48px; opacity: 0.5; margin-bottom: 16px;"></ion-icon>
                                        <h3 style="margin: 0 0 4px 0; font-size: 16px; color: #475569;">No projects yet</h3>
                                        <p style="margin: 0; font-size: 14px;">Projects assigned to students will appear here.</p>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Project Modal -->
<div id="projectModal" class="modal" style="display:none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; overflow: auto; background-color: rgba(17, 24, 39, 0.5); backdrop-filter: blur(4px);">
    <div class="modal-content" style="background-color: #ffffff; margin: 5% auto; padding: 0; border: 1px solid #EAECF0; border-radius: 16px; width: 90%; max-width: 600px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04); overflow: hidden;">
        <div class="modal-header" style="padding: 24px 24px 16px 24px; border-bottom: 1px solid #EAECF0; display: flex; justify-content: space-between; align-items: center; background-color: #F8FAFC;">
            <h3 id="modalTitle" style="margin: 0; font-size: 18px; font-weight: 600; color: #111827;">Add New Project</h3>
            <span class="close" onclick="closeProjectModal()" style="color: #64748B; font-size: 24px; font-weight: bold; cursor: pointer; line-height: 1; transition: color 0.2s;" onmouseover="this.style.color='#111827'" onmouseout="this.style.color='#64748B'">&times;</span>
        </div>
        <form id="projectForm" class="modal-body" style="padding: 24px;">
            <input type="hidden" id="project_id" name="project_id">
            
            <div class="form-row" style="margin-bottom: 16px;">
                <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
                    <label style="font-size: 13px; font-weight: 500; color: #475569;">Project Title <span style="color: #EF4444;">*</span></label>
                    <input type="text" id="project_name" name="project_name" required style="padding: 10px 12px; border: 1px solid #CBD5E1; border-radius: 8px; font-size: 14px; outline: none; transition: border-color 0.2s; font-family: 'DM Sans', sans-serif;" onfocus="this.style.borderColor='#3B82F6'" onblur="this.style.borderColor='#CBD5E1'">
                </div>
            </div>
            <div class="form-row" style="margin-bottom: 16px;">
                <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
                    <label style="font-size: 13px; font-weight: 500; color: #475569;">Student(s) <span style="color: #EF4444;">*</span></label>
                    <input type="text" id="students" name="students" placeholder="Sarah Chen, Mike Johnson" required style="padding: 10px 12px; border: 1px solid #CBD5E1; border-radius: 8px; font-size: 14px; outline: none; transition: border-color 0.2s; font-family: 'DM Sans', sans-serif;" onfocus="this.style.borderColor='#3B82F6'" onblur="this.style.borderColor='#CBD5E1'">
                </div>
            </div>
            <div class="form-row" style="margin-bottom: 16px;">
                <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
                    <label style="font-size: 13px; font-weight: 500; color: #475569;">Supervisor <span style="color: #EF4444;">*</span></label>
                    <input type="text" id="supervisor" name="supervisor" required style="padding: 10px 12px; border: 1px solid #CBD5E1; border-radius: 8px; font-size: 14px; outline: none; transition: border-color 0.2s; font-family: 'DM Sans', sans-serif;" onfocus="this.style.borderColor='#3B82F6'" onblur="this.style.borderColor='#CBD5E1'">
                </div>
            </div>
            <div class="form-row" style="margin-bottom: 16px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
                    <label style="font-size: 13px; font-weight: 500; color: #475569;">Start Date <span style="color: #EF4444;">*</span></label>
                    <input type="date" id="start_date" name="start_date" required style="padding: 10px 12px; border: 1px solid #CBD5E1; border-radius: 8px; font-size: 14px; outline: none; transition: border-color 0.2s; font-family: 'DM Sans', sans-serif; color: #111827;" onfocus="this.style.borderColor='#3B82F6'" onblur="this.style.borderColor='#CBD5E1'">
                </div>
                <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
                    <label style="font-size: 13px; font-weight: 500; color: #475569;">Due Date <span style="color: #EF4444;">*</span></label>
                    <input type="date" id="due_date" name="due_date" required style="padding: 10px 12px; border: 1px solid #CBD5E1; border-radius: 8px; font-size: 14px; outline: none; transition: border-color 0.2s; font-family: 'DM Sans', sans-serif; color: #111827;" onfocus="this.style.borderColor='#3B82F6'" onblur="this.style.borderColor='#CBD5E1'">
                </div>
            </div>
            <div class="form-row" style="margin-bottom: 16px;">
                <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
                    <label style="font-size: 13px; font-weight: 500; color: #475569;">Technology Stack <span style="color: #EF4444;">*</span></label>
                    <input type="text" id="technology_stack" name="technology_stack" placeholder="React, Node.js, MongoDB" required style="padding: 10px 12px; border: 1px solid #CBD5E1; border-radius: 8px; font-size: 14px; outline: none; transition: border-color 0.2s; font-family: 'DM Sans', sans-serif;" onfocus="this.style.borderColor='#3B82F6'" onblur="this.style.borderColor='#CBD5E1'">
                </div>
            </div>
            <div class="form-row" style="margin-bottom: 16px;">
                <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
                    <label style="font-size: 13px; font-weight: 500; color: #475569;">Repository URL</label>
                    <input type="url" id="repository_url" name="repository_url" placeholder="https://github.com/username/repo" style="padding: 10px 12px; border: 1px solid #CBD5E1; border-radius: 8px; font-size: 14px; outline: none; transition: border-color 0.2s; font-family: 'DM Sans', sans-serif;" onfocus="this.style.borderColor='#3B82F6'" onblur="this.style.borderColor='#CBD5E1'">
                </div>
            </div>
            <div class="form-row" style="margin-bottom: 0;">
                <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
                    <label style="font-size: 13px; font-weight: 500; color: #475569;">Project Description</label>
                    <textarea id="description" name="description" rows="3" placeholder="Brief description of the project..." style="padding: 10px 12px; border: 1px solid #CBD5E1; border-radius: 8px; font-size: 14px; outline: none; transition: border-color 0.2s; font-family: 'DM Sans', sans-serif; resize: vertical;" onfocus="this.style.borderColor='#3B82F6'" onblur="this.style.borderColor='#CBD5E1'"></textarea>
                </div>
            </div>
        </form>
        <div class="modal-footer" style="padding: 16px 24px; border-top: 1px solid #EAECF0; display: flex; justify-content: flex-end; gap: 12px; background-color: #F8FAFC;">
            <button class="btn-secondary" onclick="closeProjectModal()" style="padding: 8px 16px; border: 1px solid #CBD5E1; background-color: #ffffff; color: #475569; border-radius: 8px; font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.2s; font-family: 'DM Sans', sans-serif;" onmouseover="this.style.backgroundColor='#F1F5F9'" onmouseout="this.style.backgroundColor='#ffffff'">Cancel</button>
            <button type="button" class="btn-primary" id="saveProjectBtn" onclick="saveProject()" style="padding: 8px 16px; border: none; background-color: #0052FF; color: #ffffff; border-radius: 8px; font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.2s; font-family: 'DM Sans', sans-serif;" onmouseover="this.style.backgroundColor='#0043D1'" onmouseout="this.style.backgroundColor='#0052FF'">Save Project</button>
        </div>
    </div>
</div>

<script>
function showAddProjectModal() {
    document.getElementById('modalTitle').textContent = 'Add New Project';
    document.getElementById('projectForm').reset();
    document.getElementById('project_id').value = '';
    document.getElementById('projectModal').style.display = 'block';
}

function closeProjectModal() {
    document.getElementById('projectModal').style.display = 'none';
}

async function saveProject() {
    const form = document.getElementById('projectForm');
    const id = document.getElementById('project_id').value;

    const requiredFields = form.querySelectorAll('[required]');
    let valid = true;
    requiredFields.forEach(field => {
        if (!field.value.trim()) { valid = false; field.style.borderColor = 'red'; }
        else { field.style.borderColor = ''; }
    });

    if (!valid) { showNotification('Please fill in all required fields.', 'error'); return; }

    const data = {
        project_name: document.getElementById('project_name').value.trim(),
        students: document.getElementById('students').value.trim(),
        supervisor: document.getElementById('supervisor').value.trim(),
        start_date: document.getElementById('start_date').value,
        due_date: document.getElementById('due_date').value,
        technology_stack: document.getElementById('technology_stack').value.trim(),
        repository_url: document.getElementById('repository_url').value.trim(),
        description: document.getElementById('description').value.trim()
    };

    const url = id ? '/api/projects/' + id : '/api/projects';
    const method = id ? 'PUT' : 'POST';

    try {
        const response = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await response.json();
        if (result.success) {
            closeProjectModal();
            showNotification(result.message, 'success');
            setTimeout(() => location.reload(), 800);
        } else {
            showNotification(result.message || 'Failed to save project.', 'error');
        }
    } catch (e) {
        showNotification('Network error.', 'error');
    }
}

async function markComplete(projectId) {
    if (!confirm('Mark this project as completed?')) return;
    try {
        const response = await fetch(`/api/projects/${projectId}/complete`, { method: 'POST' });
        const result = await response.json();
        if (result.success) {
            showNotification(result.message, 'success');
            setTimeout(() => location.reload(), 800);
        } else {
            showNotification(result.message || 'Failed.', 'error');
        }
    } catch (e) {
        showNotification('Network error.', 'error');
    }
}

async function deleteProject(projectId) {
    if (!confirm('Are you sure you want to delete this project?')) return;
    try {
        const response = await fetch(`/api/projects/${projectId}`, { method: 'DELETE' });
        const result = await response.json();
        if (result.success) {
            document.querySelector(`tr[data-project-id="${projectId}"]`)?.remove();
            showNotification(result.message, 'success');
        } else {
            showNotification(result.message || 'Delete failed.', 'error');
        }
    } catch (e) {
        showNotification('Network error.', 'error');
    }
}

async function editProject(projectId) {
    // Fetch project details
    const row = document.querySelector(`tr[data-project-id="${projectId}"]`);
    if (!row) return;

    document.getElementById('modalTitle').textContent = 'Edit Project';
    document.getElementById('project_id').value = projectId;

    // Fill form from existing cells or fetch from DB
    // To make it instant, populate from DOM:
    const title = row.querySelector('.project-title').textContent.trim();
    const students = row.querySelector('.student-cell').textContent.trim();
    const supervisor = row.querySelector('.supervisor-cell').textContent.trim();
    
    // Dates need to be parsed to YYYY-MM-DD
    // Or we can fetch details from server. Let's do a quick fetch for exact data:
    try {
        const response = await fetch('/api/projects');
        const result = await response.json();
        if (result.success) {
            const project = result.data.find(p => p._id === projectId);
            if (project) {
                document.getElementById('project_name').value = project.project_name;
                document.getElementById('students').value = project.students;
                document.getElementById('supervisor').value = project.supervisor;
                document.getElementById('start_date').value = new Date(project.start_date).toISOString().split('T')[0];
                document.getElementById('due_date').value = new Date(project.due_date).toISOString().split('T')[0];
                document.getElementById('technology_stack').value = project.technology_stack;
                document.getElementById('repository_url').value = project.repository_url || '';
                document.getElementById('description').value = project.description || '';
                
                document.getElementById('projectModal').style.display = 'block';
            }
        }
    } catch (e) {
        showNotification('Failed to fetch project details.', 'error');
    }
}

// Search
document.getElementById('projectSearch')?.addEventListener('input', function(e) {
    const term = e.target.value.toLowerCase();
    document.querySelectorAll('#projects-tbody tr').forEach(row => {
        if (row.querySelector('.projects-empty')) return;
        const title = row.querySelector('.project-title')?.textContent.toLowerCase() || '';
        const students = row.querySelector('.student-cell')?.textContent.toLowerCase() || '';
        const supervisor = row.querySelector('.supervisor-cell')?.textContent.toLowerCase() || '';
        const tech = row.querySelector('.tech-stack')?.textContent.toLowerCase() || '';
        row.style.display = (title.includes(term) || students.includes(term) || supervisor.includes(term) || tech.includes(term)) ? '' : 'none';
    });
});

window.showAddProjectModal = showAddProjectModal;
window.closeProjectModal = closeProjectModal;
window.saveProject = saveProject;
window.markComplete = markComplete;
window.deleteProject = deleteProject;
window.editProject = editProject;
</script>
