<div id="projects-page" class="page-content">
    <div class="projects-container">
        <div class="projects-header">
            <div class="projects-actions">
                <div class="search-box">
                    <ion-icon name="search-outline" class="search-icon-projects"></ion-icon>
                    <input type="text" id="projectSearch" placeholder="Search projects...">
                </div>
                <button class="btn btn-primary" onclick="showAddProjectModal()">
                    <ion-icon name="add-outline"></ion-icon> Add Project
                </button>
            </div>
        </div>

        <div class="table-container">
            <table class="projects-table">
                <thead>
                    <tr>
                        <th>Project Title</th>
                        <th>Student(s)</th>
                        <th>Supervised By</th>
                        <th>Date Started</th>
                        <th>Due Date</th>
                        <th>Tech Stack</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="projects-tbody">
                    <% if (projects && projects.length > 0) { %>
                        <% projects.forEach(project => { %>
                            <% 
                            const isCompleted = project.status === 'Completed';
                            const isOverdue = !isCompleted && new Date(project.due_date) < new Date();
                            %>
                            <tr class="<%= isCompleted ? 'completed' : '' %>" data-project-id="<%= project._id %>">
                                <td>
                                    <div class="project-title"><%= project.project_name %></div>
                                    <div class="project-mobile-info">
                                        <div class="mobile-stack"><%= project.technology_stack %></div>
                                        <div class="mobile-dates">
                                            <span>Start: <%= new Date(project.start_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                                            <span>Due: <%= new Date(project.due_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                                        </div>
                                    </div>
                                </td>
                                <td class="student-cell"><%= project.students %></td>
                                <td class="supervisor-cell"><%= project.supervisor %></td>
                                <td class="start-date-cell"><%= new Date(project.start_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></td>
                                <td class="due-date-cell">
                                    <div class="due-date <%= isCompleted ? 'completed' : (isOverdue ? 'overdue' : '') %>">
                                        <%= new Date(project.due_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                    </div>
                                </td>
                                <td class="tech-stack-cell">
                                    <div class="tech-stack"><%= project.technology_stack %></div>
                                </td>
                                <td class="status-cell">
                                    <span class="status-badge status-<%= project.status.toLowerCase().replace(' ', '-') %>">
                                        <%= project.status %>
                                    </span>
                                </td>
                                <td class="actions-cell">
                                    <div class="action-buttons">
                                        <% if (project.repository_url) { %>
                                            <a href="<%= project.repository_url %>" target="_blank" class="btn-icon view-source" title="View Source">
                                                <ion-icon name="code-slash-outline"></ion-icon>
                                            </a>
                                        <% } else { %>
                                            <button class="btn-icon view-source" disabled title="No repository URL">
                                                <ion-icon name="code-slash-outline"></ion-icon>
                                            </button>
                                        <% } %>
                                        
                                        <% if (!isCompleted) { %>
                                            <button class="btn-icon complete" onclick="markComplete('<%= project._id %>')" title="Mark Complete">
                                                <ion-icon name="checkmark-circle-outline"></ion-icon>
                                            </button>
                                        <% } %>
                                        
                                        <button class="btn-icon edit" onclick="editProject('<%= project._id %>')" title="Edit">
                                            <ion-icon name="create-outline"></ion-icon>
                                        </button>
                                        
                                        <button class="btn-icon delete" onclick="deleteProject('<%= project._id %>')" title="Delete">
                                            <ion-icon name="trash-outline"></ion-icon>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" style="text-align: center; padding: 2rem;">
                                <div class="projects-empty" style="text-align:center; color:#aaa;">
                                    <i class="fas fa-folder-open" style="font-size:3rem; margin-bottom:1rem; opacity:0.4;"></i>
                                    <h3>No projects yet</h3>
                                    <p>Projects assigned to interns will appear here.</p>
                                </div>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add/Edit Project Modal -->
<div id="projectModal" class="modal" style="display:none;">
    <div class="modal-content">
        <div class="modal-header">
            <h3 id="modalTitle">Add New Project</h3>
            <span class="close" onclick="closeProjectModal()">&times;</span>
        </div>
        <form id="projectForm" class="modal-body">
            <input type="hidden" id="project_id" name="project_id">
            
            <div class="form-row">
                <div class="form-group">
                    <label>Project Title *</label>
                    <input type="text" id="project_name" name="project_name" required>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Student(s) *</label>
                    <input type="text" id="students" name="students" placeholder="Sarah Chen, Mike Johnson" required>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Supervisor *</label>
                    <input type="text" id="supervisor" name="supervisor" required>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Start Date *</label>
                    <input type="date" id="start_date" name="start_date" required>
                </div>
                <div class="form-group">
                    <label>Due Date *</label>
                    <input type="date" id="due_date" name="due_date" required>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Technology Stack *</label>
                    <input type="text" id="technology_stack" name="technology_stack" placeholder="React, Node.js, MongoDB" required>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Repository URL</label>
                    <input type="url" id="repository_url" name="repository_url" placeholder="https://github.com/username/repo">
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Project Description</label>
                    <textarea id="description" name="description" rows="3" placeholder="Brief description of the project..."></textarea>
                </div>
            </div>
        </form>
        <div class="modal-footer">
            <button class="btn-secondary" onclick="closeProjectModal()">Cancel</button>
            <button type="button" class="btn-primary" id="saveProjectBtn" onclick="saveProject()">Save Project</button>
        </div>
    </div>
</div>

<script>
function showAddProjectModal() {
    document.getElementById('modalTitle').textContent = 'Add New Project';
    document.getElementById('projectForm').reset();
    document.getElementById('project_id').value = '';
    document.getElementById('projectModal').style.display = 'block';
}

function closeProjectModal() {
    document.getElementById('projectModal').style.display = 'none';
}

async function saveProject() {
    const form = document.getElementById('projectForm');
    const id = document.getElementById('project_id').value;

    const requiredFields = form.querySelectorAll('[required]');
    let valid = true;
    requiredFields.forEach(field => {
        if (!field.value.trim()) { valid = false; field.style.borderColor = 'red'; }
        else { field.style.borderColor = ''; }
    });

    if (!valid) { showNotification('Please fill in all required fields.', 'error'); return; }

    const data = {
        project_name: document.getElementById('project_name').value.trim(),
        students: document.getElementById('students').value.trim(),
        supervisor: document.getElementById('supervisor').value.trim(),
        start_date: document.getElementById('start_date').value,
        due_date: document.getElementById('due_date').value,
        technology_stack: document.getElementById('technology_stack').value.trim(),
        repository_url: document.getElementById('repository_url').value.trim(),
        description: document.getElementById('description').value.trim()
    };

    const url = id ? '/api/projects/' + id : '/api/projects';
    const method = id ? 'PUT' : 'POST';

    try {
        const response = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await response.json();
        if (result.success) {
            closeProjectModal();
            showNotification(result.message, 'success');
            setTimeout(() => location.reload(), 800);
        } else {
            showNotification(result.message || 'Failed to save project.', 'error');
        }
    } catch (e) {
        showNotification('Network error.', 'error');
    }
}

async function markComplete(projectId) {
    if (!confirm('Mark this project as completed?')) return;
    try {
        const response = await fetch(`/api/projects/${projectId}/complete`, { method: 'POST' });
        const result = await response.json();
        if (result.success) {
            showNotification(result.message, 'success');
            setTimeout(() => location.reload(), 800);
        } else {
            showNotification(result.message || 'Failed.', 'error');
        }
    } catch (e) {
        showNotification('Network error.', 'error');
    }
}

async function deleteProject(projectId) {
    if (!confirm('Are you sure you want to delete this project?')) return;
    try {
        const response = await fetch(`/api/projects/${projectId}`, { method: 'DELETE' });
        const result = await response.json();
        if (result.success) {
            document.querySelector(`tr[data-project-id="${projectId}"]`)?.remove();
            showNotification(result.message, 'success');
        } else {
            showNotification(result.message || 'Delete failed.', 'error');
        }
    } catch (e) {
        showNotification('Network error.', 'error');
    }
}

async function editProject(projectId) {
    // Fetch project details
    const row = document.querySelector(`tr[data-project-id="${projectId}"]`);
    if (!row) return;

    document.getElementById('modalTitle').textContent = 'Edit Project';
    document.getElementById('project_id').value = projectId;

    // Fill form from existing cells or fetch from DB
    // To make it instant, populate from DOM:
    const title = row.querySelector('.project-title').textContent.trim();
    const students = row.querySelector('.student-cell').textContent.trim();
    const supervisor = row.querySelector('.supervisor-cell').textContent.trim();
    
    // Dates need to be parsed to YYYY-MM-DD
    // Or we can fetch details from server. Let's do a quick fetch for exact data:
    try {
        const response = await fetch('/api/projects');
        const result = await response.json();
        if (result.success) {
            const project = result.data.find(p => p._id === projectId);
            if (project) {
                document.getElementById('project_name').value = project.project_name;
                document.getElementById('students').value = project.students;
                document.getElementById('supervisor').value = project.supervisor;
                document.getElementById('start_date').value = new Date(project.start_date).toISOString().split('T')[0];
                document.getElementById('due_date').value = new Date(project.due_date).toISOString().split('T')[0];
                document.getElementById('technology_stack').value = project.technology_stack;
                document.getElementById('repository_url').value = project.repository_url || '';
                document.getElementById('description').value = project.description || '';
                
                document.getElementById('projectModal').style.display = 'block';
            }
        }
    } catch (e) {
        showNotification('Failed to fetch project details.', 'error');
    }
}

// Search
document.getElementById('projectSearch')?.addEventListener('input', function(e) {
    const term = e.target.value.toLowerCase();
    document.querySelectorAll('#projects-tbody tr').forEach(row => {
        if (row.querySelector('.projects-empty')) return;
        const title = row.querySelector('.project-title')?.textContent.toLowerCase() || '';
        const students = row.querySelector('.student-cell')?.textContent.toLowerCase() || '';
        const supervisor = row.querySelector('.supervisor-cell')?.textContent.toLowerCase() || '';
        const tech = row.querySelector('.tech-stack')?.textContent.toLowerCase() || '';
        row.style.display = (title.includes(term) || students.includes(term) || supervisor.includes(term) || tech.includes(term)) ? '' : 'none';
    });
});

window.showAddProjectModal = showAddProjectModal;
window.closeProjectModal = closeProjectModal;
window.saveProject = saveProject;
window.markComplete = markComplete;
window.deleteProject = deleteProject;
window.editProject = editProject;
</script>
