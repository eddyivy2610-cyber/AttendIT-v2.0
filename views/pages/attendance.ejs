<div id="attendance-page" class="page-content">

    <!-- Attendance Summary Cards -->
    <div class="attendance-summary">
        <div class="summary-card present">
            <i class="fas fa-user-check"></i>
            <div>
                <h3 id="present-count"><%= summary.presentCount %></h3>
                <p>Present</p>
            </div>
        </div>
        <div class="summary-card absent">
            <i class="fas fa-user-times"></i>
            <div>
                <h3 id="absent-count"><%= summary.absentCount %></h3>
                <p>Absent</p>
            </div>
        </div>
        <div class="summary-card late">
            <i class="fas fa-user-clock"></i>
            <div>
                <h3 id="late-count"><%= summary.lateCount %></h3>
                <p>Late</p>
            </div>
        </div>
        <div class="summary-card expected">
            <i class="fas fa-users"></i>
            <div>
                <h3 id="expected-count"><%= summary.totalStudents %></h3>
                <p>Expected</p>
            </div>
        </div>
    </div>

    <!-- Students Table -->
    <div class="students-container">
        <div class="students-header">
            <h2>Interns (<%= summary.totalStudents %>)</h2>
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Search students..." id="searchInput">
            </div>
            <div class="attendance-actions">
                <button class="btn btn-primary" onclick="markAllSignedIn()">
                    <i class="fas fa-check-circle"></i> Mark All Signed In
                </button>
                <button class="btn btn-secondary" onclick="resetTodayAttendance()">
                    <i class="fas fa-undo"></i> Reset Today
                </button>
            </div>
        </div>

        <table class="students-table">
            <thead>
                <tr>
                    <th>S/N</th>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Course</th>
                    <th>Institution</th>
                    <th>Arrival Time</th>
                    <th>Actions</th>
                    <th>Depart Time</th>
                </tr>
            </thead>
            <tbody id="attendance-tbody">
                <%
                // Group students by institution
                const grouped = {};
                students.forEach(s => {
                    const instName = s.institution ? s.institution.institution_name : 'Unknown Institution';
                    if (!grouped[instName]) grouped[instName] = [];
                    grouped[instName].push(s);
                });

                let serial = 1;
                Object.keys(grouped).forEach(institutionName => {
                    const instStudents = grouped[institutionName];
                %>
                    <tr class="institution-header">
                        <td colspan="8" class="institution-name">
                            <i class="fas fa-university"></i> <%= institutionName %>
                            <span class="student-count">(<%= instStudents.length %> students)</span>
                        </td>
                    </tr>
                    <% instStudents.forEach(student => {
                        const att = attendanceMap[student._id.toString()];
                        const isSignedIn = att && att.arrival_time;
                        const isSignedOut = att && att.departure_time;
                        const status = att ? att.status : 'Absent';
                        const arrivalTime = isSignedIn ? new Date(att.arrival_time).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }) : '--';
                        const departTime = isSignedOut ? new Date(att.departure_time).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }) : '--';
                    %>
                    <tr data-student-id="<%= student._id %>" data-institution="<%= institutionName %>">
                        <td class="serial-number"><%= serial++ %></td>
                        <td>
                            <img src="<%= student.photo_url ? '/' + student.photo_url : 'https://picsum.photos/seed/' + encodeURIComponent(student.student_name) + '/50/50.jpg' %>"
                                 alt="<%= student.student_name %>" class="student-img">
                        </td>
                        <td>
                            <div class="student-name"><%= student.student_name %></div>
                            <div class="student-gender"><%= student.gender || '' %></div>
                            <div class="student-mobile-info">
                                <%= student.course_of_study || '--' %> • 
                                <%= institutionName %>
                            </div>
                        </td>
                        <td class="student-course"><%= student.course_of_study || '--' %></td>
                        <td class="student-institution"><%= institutionName %></td>
                        <td class="time-display arrival-time"><%= arrivalTime %></td>
                        <td>
                            <div class="action-buttons">
                                <% if (!isSignedIn) { %>
                                    <button class="btn btn-signin" onclick="handleSignIn('<%= student._id %>')">
                                        <i class="fas fa-sign-in-alt"></i> Sign In
                                    </button>
                                <% } else { %>
                                    <button class="btn <%= status === 'Late' ? 'btn-late' : 'btn-signed' %>" disabled>
                                        <i class="fas <%= status === 'Late' ? 'fa-clock' : 'fa-check' %>"></i> <%= status %>
                                    </button>
                                <% } %>

                                <% if (isSignedIn && !isSignedOut) { %>
                                    <button class="btn btn-signout" onclick="handleSignOut('<%= student._id %>')">
                                        <i class="fas fa-sign-out-alt"></i> Sign Out
                                    </button>
                                <% } else if (isSignedOut) { %>
                                    <button class="btn btn-signed-out" disabled>
                                        <i class="fas fa-check"></i> Signed Out
                                    </button>
                                <% } else { %>
                                    <button class="btn btn-signout" disabled>
                                        <i class="fas fa-sign-out-alt"></i> Sign Out
                                    </button>
                                <% } %>
                            </div>
                        </td>
                        <td class="time-display depart-time"><%= departTime %></td>
                    </tr>
                    <% }) %>
                <% }); %>

                <% if (students.length === 0) { %>
                    <tr><td colspan="8" style="text-align: center; padding: 2rem;">No active students found.</td></tr>
                <% } %>
            </tbody>
        </table>

        <!-- Submit Attendance -->
        <div class="submit-attendance-container">
            <button class="btn btn-submit" onclick="submitAttendanceReport()">
                <i class="fas fa-paper-plane"></i> Submit Attendance Report
            </button>
        </div>
    </div>
</div>

<script>
async function handleSignIn(studentId) {
    const row = document.querySelector(`tr[data-student-id="${studentId}"]`);
    try {
        const response = await fetch('/api/attendance/signin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ student_id: studentId })
        });
        const result = await response.json();
        if (result.success) {
            showNotification(result.message, 'success');
            setTimeout(() => location.reload(), 800);
        } else {
            showNotification(result.message || 'Sign in failed.', 'error');
        }
    } catch (err) {
        showNotification('Network error.', 'error');
    }
}

async function handleSignOut(studentId) {
    try {
        const response = await fetch('/api/attendance/signout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ student_id: studentId })
        });
        const result = await response.json();
        if (result.success) {
            showNotification('Signed out successfully!', 'success');
            setTimeout(() => location.reload(), 800);
        } else {
            showNotification(result.message || 'Sign out failed.', 'error');
        }
    } catch (err) {
        showNotification('Network error.', 'error');
    }
}

async function markAllSignedIn() {
    if (!confirm('Mark all students as signed in?')) return;
    const rows = document.querySelectorAll('tr[data-student-id]');
    const ids = Array.from(rows).map(r => r.dataset.studentId);

    let count = 0;
    for (const id of ids) {
        const res = await fetch('/api/attendance/signin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ student_id: id })
        });
        const data = await res.json();
        if (data.success) count++;
    }
    showNotification(`${count} students signed in.`, 'success');
    setTimeout(() => location.reload(), 1000);
}

async function resetTodayAttendance() {
    if (!confirm('Reset all attendance for today? This will delete all records.')) return;
    try {
        const response = await fetch('/api/attendance/reset', { method: 'DELETE' });
        const result = await response.json();
        if (result.success) {
            showNotification(result.message, 'success');
            setTimeout(() => location.reload(), 1000);
        } else {
            showNotification(result.message || 'Reset failed.', 'error');
        }
    } catch (err) {
        showNotification('Network error.', 'error');
    }
}

async function submitAttendanceReport() {
    if (!confirm("Submit today's attendance report? This will finalize all records for today.")) return;
    showNotification('Attendance report submitted successfully!', 'success');
}

// Search
document.getElementById('searchInput').addEventListener('input', function(e) {
    const term = e.target.value.toLowerCase();
    document.querySelectorAll('tr[data-student-id]').forEach(row => {
        const name = row.querySelector('.student-name')?.textContent.toLowerCase() || '';
        const institution = row.dataset.institution?.toLowerCase() || '';
        row.style.display = (name.includes(term) || institution.includes(term)) ? '' : 'none';
    });
});

window.handleSignIn = handleSignIn;
window.handleSignOut = handleSignOut;
window.markAllSignedIn = markAllSignedIn;
window.resetAllAttendance = resetTodayAttendance;
</script>
