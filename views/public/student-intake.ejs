<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Register Form</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&family=Sora:wght@400;500;600;700&display=swap');
        :root {
            --bg: #0f172a;
            --panel: #111827;
            --panel-2: #1f2937;
            --text: #e5e7eb;
            --muted: #94a3b8;
            --accent: #22c55e;
            --accent-2: #2563eb;
            --danger: #ef4444;
            --border: rgba(148, 163, 184, 0.18);
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: 'Poppins', 'Sora', sans-serif;
            background: radial-gradient(circle at top, #1e293b 0%, #0f172a 48%, #020617 100%);
            color: var(--text);
            min-height: 100vh;
        }
        .wrap {
            max-width: 960px;
            margin: 0 auto;
            padding: 32px 16px 48px;
        }
        .hero, .card {
            background: rgba(15, 23, 42, 0.82);
            border: 1px solid var(--border);
            backdrop-filter: blur(10px);
            border-radius: 18px;
            box-shadow: 0 18px 60px rgba(0, 0, 0, 0.28);
        }
        .hero {
            padding: 28px;
            margin-bottom: 18px;
        }
        h1 { margin: 0 0 8px; font-size: 2rem; font-family: 'Poppins', 'Sora', sans-serif; font-weight: 800; }
        p { color: var(--muted); line-height: 1.6; font-family: 'Sora', 'Poppins', sans-serif; }
        .status {
            margin: 18px 0 0;
            padding: 12px 14px;
            border-radius: 12px;
            font-weight: 600;
        }
        .success { background: rgba(34, 197, 94, 0.12); color: #86efac; border: 1px solid rgba(34, 197, 94, 0.3); }
        .error { background: rgba(239, 68, 68, 0.12); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.3); }
        .card { padding: 24px; }
        .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
        .field { display: flex; flex-direction: column; gap: 6px; }
        label { font-weight: 600; font-size: 0.95rem; font-family: 'Sora', 'Poppins', sans-serif; }
        input, select {
            width: 100%;
            border: 1px solid var(--border);
            background: var(--panel-2);
            color: var(--text);
            border-radius: 10px;
            padding: 12px 14px;
            outline: none;
        }
        input:focus, select:focus { border-color: rgba(37, 99, 235, 0.7); }
        .full { grid-column: 1 / -1; }
        .actions {
            display: flex;
            gap: 12px;
            margin-top: 18px;
            align-items: center;
        }
        button {
            border: 0;
            border-radius: 10px;
            padding: 12px 18px;
            font-weight: 700;
            cursor: pointer;
        }
        .primary { background: var(--accent-2); color: white; }
        .ghost { background: transparent; color: var(--muted); border: 1px solid var(--border); }
        small { color: var(--muted); }
        .note { margin-top: 14px; font-size: 0.95rem; }
        @media (max-width: 720px) {
            .grid { grid-template-columns: 1fr; }
            h1 { font-size: 1.6rem; }
        }
    </style>
</head>
<body>
    <div class="wrap">
        <div class="hero">
            <h1>Student Register Form</h1>
            <p>Submit a student directly from the QR link. The record is created as pending and will appear in the main app for approval.</p>
            <% if (success) { %>
                <div class="status success">Submission received. An admin will review and approve it in the main app.</div>
            <% } %>
            <% if (error) { %>
                <div class="status error"><%= error %></div>
            <% } %>
        </div>

        <div class="card">
            <form method="POST" action="<%= publicFormAction %>">
                <div class="grid">
                    <div class="field">
                        <label for="student_name">Full Name *</label>
                        <input id="student_name" name="student_name" type="text" required value="<%= formData.student_name || '' %>">
                    </div>
                    <div class="field">
                        <label for="email">Email *</label>
                        <input id="email" name="email" type="email" required value="<%= formData.email || '' %>">
                    </div>
                    <div class="field">
                        <label for="phone">Phone *</label>
                        <input id="phone" name="phone" type="tel" required value="<%= formData.phone || '' %>">
                    </div>
                    <div class="field">
                        <label for="gender">Gender *</label>
                        <select id="gender" name="gender" required>
                            <option value="">Select gender</option>
                            <option value="Male" <%= formData.gender === 'Male' ? 'selected' : '' %>>Male</option>
                            <option value="Female" <%= formData.gender === 'Female' ? 'selected' : '' %>>Female</option>
                            <option value="Other" <%= formData.gender === 'Other' ? 'selected' : '' %>>Other</option>
                        </select>
                    </div>
                    <div class="field full">
                        <label for="institution_id">Institution *</label>
                        <select id="institution_id" name="institution_id" required>
                            <option value="">Select institution</option>
                            <% (institutions || []).forEach(inst => { %>
                                <option value="<%= inst._id %>" <%= String(formData.institution_id || '') === String(inst._id) ? 'selected' : '' %>><%= inst.institution_name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="field full">
                        <label for="course_of_study">Course of Study *</label>
                        <input id="course_of_study" name="course_of_study" type="text" required value="<%= formData.course_of_study || '' %>">
                    </div>
                    <div class="field">
                        <label for="period_of_attachment">Period of Attachment</label>
                        <input id="period_of_attachment" name="period_of_attachment" type="number" min="1" max="24" value="<%= formData.period_of_attachment || 6 %>">
                    </div>
                    <div class="field">
                        <label for="skill_of_interest">Skill Interest</label>
                        <input id="skill_of_interest" name="skill_of_interest" type="text" value="<%= formData.skill_of_interest || '' %>">
                    </div>
                    <div class="field full">
                        <label for="supervisor">Supervisor</label>
                        <input id="supervisor" name="supervisor" type="text" value="<%= formData.supervisor || '' %>">
                    </div>
                </div>

                <div class="actions">
                    <button type="submit" class="primary">Submit Student</button>
                    <button type="reset" class="ghost">Reset</button>
                </div>
                <p class="note"><small>Entries are not activated automatically. An admin must approve them in the main app.</small></p>
            </form>
        </div>
    </div>
</body>
</html>
