<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&family=Sora:wght@400;500;600;700&display=swap');
        :root {
            --bg: #0b1220;
            --panel: rgba(17, 24, 39, 0.92);
            --border: rgba(148, 163, 184, 0.18);
            --text: #e5e7eb;
            --muted: #94a3b8;
            --blue: #2563eb;
            --green: #16a34a;
            --red: #dc2626;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            background: radial-gradient(circle at top, #1e293b 0%, #0b1220 45%, #020617 100%);
            color: var(--text);
            font-family: 'Poppins', 'Sora', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .card {
            width: min(100%, 440px);
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 24px;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
        }
        h1 { margin: 0 0 8px; font-size: 1.6rem; font-family: 'Poppins', 'Sora', sans-serif; font-weight: 800; }
        p { margin: 0 0 16px; color: var(--muted); line-height: 1.5; font-family: 'Sora', 'Poppins', sans-serif; }
        .field { margin-bottom: 16px; }
        label { display: block; margin-bottom: 6px; font-weight: 700; font-family: 'Sora', 'Poppins', sans-serif; }
        input {
            width: 100%;
            padding: 14px 16px;
            border-radius: 12px;
            border: 1px solid var(--border);
            background: rgba(15, 23, 42, 0.95);
            color: var(--text);
            font-size: 1rem;
            outline: none;
        }
        input:focus { border-color: rgba(37, 99, 235, 0.8); }
        .actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
        button {
            border: 0;
            border-radius: 12px;
            padding: 14px 12px;
            font-weight: 800;
            font-size: 1rem;
            color: white;
            cursor: pointer;
        }
        .signin { background: var(--green); }
        .signout { background: var(--blue); }
        .status {
            margin-top: 16px;
            padding: 12px 14px;
            border-radius: 12px;
            font-weight: 700;
        }
        .success { background: rgba(22, 163, 74, 0.12); color: #86efac; border: 1px solid rgba(22, 163, 74, 0.3); }
        .error { background: rgba(220, 38, 38, 0.12); color: #fca5a5; border: 1px solid rgba(220, 38, 38, 0.3); }
        small { color: var(--muted); }
        @media (max-width: 420px) {
            .actions { grid-template-columns: 1fr; }
            .card { padding: 20px; }
        }
    </style>
</head>
<body>
    <div class="card">
        <h1><%= title %></h1>
        <p>Enter your phone number, look up your record, then choose sign in or sign out. The system checks the student record automatically.</p>

        <form method="POST" action="<%= formAction %>">
            <div class="field">
                <label for="phone">Phone Number</label>
                <input id="phone" name="phone" type="tel" placeholder="e.g. 2348012345678" value="<%= phone || '' %>" required>
            </div>

            <% if (student) { %>
                <div style="margin-bottom: 14px; padding: 12px 14px; border-radius: 12px; background: rgba(37, 99, 235, 0.14); border: 1px solid rgba(37, 99, 235, 0.25);">
                    <div style="font-weight: 800; margin-bottom: 4px;">Matched Student</div>
                    <div><%= student.student_name %></div>
                    <div><small>Phone: <%= student.phone %></small></div>
                    <% if (attendanceState) { %>
                        <div style="margin-top: 6px;"><small>Today: <%= attendanceState.label %></small></div>
                    <% } %>
                </div>
            <% } %>

            <% if (!student) { %>
                <div class="actions">
                    <button type="submit" name="action" value="lookup" class="signout">Look Up</button>
                </div>
            <% } else { %>
                <div class="actions">
                    <button type="submit" name="action" value="signin" class="signin">Sign In</button>
                    <button type="submit" name="action" value="signout" class="signout">Sign Out</button>
                </div>
            <% } %>
        </form>

        <% if (success && message) { %>
            <div class="status success"><%= message %></div>
        <% } %>
        <% if (error) { %>
            <div class="status error"><%= error %></div>
        <% } %>
        <p style="margin-top:14px;"><small>Attendance is only allowed for approved active students.</small></p>
    </div>
</body>
</html>
