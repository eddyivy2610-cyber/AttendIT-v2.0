<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Attendit - Student Management System</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
    <link href='https://cdn.boxicons.com/fonts/basic/boxicons.min.css' rel='stylesheet'>
    <link href='https://cdn.boxicons.com/fonts/brands/boxicons-brands.min.css' rel='stylesheet'>
    <link rel="stylesheet" href="/assets/css/home.css">
    <link rel="stylesheet" href="/assets/css/dashboard.css">
    <link rel="stylesheet" href="/assets/css/students.css">
    <link rel="stylesheet" href="/assets/css/attendance.css">
    <link rel="stylesheet" href="/assets/css/reports.css">
    <link rel="stylesheet" href="/assets/css/settings.css">
    <link rel="stylesheet" href="/assets/css/projects.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

    <div class="theme-transition-overlay" id="themeOverlay"></div>

    <!-- Mobile Top Navigation Toggle -->
    <button class="top-nav-toggle" id="topNavToggle" aria-label="Toggle navigation">
        <ion-icon name="menu-outline"></ion-icon>
    </button>

    <!-- Mobile Top Navigation -->
    <nav class="top-nav" id="topNav">
        <ul class="top-nav-list">
            <a href="/?page=dashboard" class="top-nav-item <%= page == 'dashboard' ? 'active' : '' %>" data-index="0">
                <ion-icon name="grid-outline"></ion-icon>
                <span>Dashboard</span>
            </a>
            <a href="/?page=students" class="top-nav-item <%= page == 'students' ? 'active' : '' %>" data-index="1">
                <ion-icon name="people-outline"></ion-icon>
                <span>Students</span>
            </a>
            <a href="/?page=attendance" class="top-nav-item <%= page == 'attendance' ? 'active' : '' %>" data-index="2">
                <ion-icon name="calendar-outline"></ion-icon>
                <span>Attendance</span>
            </a>
            <a href="/?page=projects" class="top-nav-item <%= page == 'projects' ? 'active' : '' %>" data-index="3">
                <ion-icon name="folder-open-outline"></ion-icon>
                <span>Projects</span>
            </a>
            <a href="/?page=reports" class="top-nav-item <%= page == 'reports' ? 'active' : '' %>" data-index="4">
                <ion-icon name="bar-chart-outline"></ion-icon>
                <span>Reports</span>
            </a>
            <a href="/?page=settings" class="top-nav-item <%= page == 'settings' ? 'active' : '' %>" data-index="5">
                <ion-icon name="settings-outline"></ion-icon>
                <span>Settings</span>
            </a>
            <a href="#" class="top-nav-item" id="mobileThemeToggle" data-index="6">
                <ion-icon name="contrast-outline"></ion-icon>
                <span>Theme</span>
            </a>
            <a href="/logout" class="top-nav-item" data-index="7">
                <ion-icon name="log-out-outline"></ion-icon>
                <span>Logout</span>
            </a>
        </ul>
    </nav>

    <div class="container">
        <!-- Sidebar Navigation -->
        <aside class="navigation new-sidebar" id="sidebar">
            <div class="sidebar-content">
                <!-- Brand Logo Header -->
                <div class="nav-brand" style="justify-content: center; align-items: center; gap: 12px; padding: 16px 0; display: flex;">
                    <img src="/assets/images/logo.png" alt="AttendIT Logo" style="max-height: 40px; width: auto;">
                    <span class="brand-text" style="margin: 0; font-family: 'Sora', sans-serif; font-weight: 700; font-size: 1.25rem;">
                        AttendIT<span class="brand-dot" style="color: var(--primary);">.</span>
                    </span>
                </div>

                <!-- Main Navigation List -->
                <nav class="main-nav">
                    <a href="/?page=dashboard" class="nav-link <%= page === 'dashboard' ? 'active' : '' %>" data-page="dashboard">
                        <ion-icon name="grid-outline"></ion-icon>
                        <span>Dashboard</span>
                    </a>
                    <a href="/?page=students" class="nav-link <%= page === 'students' ? 'active' : '' %>" data-page="students">
                        <ion-icon name="people-outline"></ion-icon>
                        <span>Students</span>
                    </a>
                    <a href="/?page=attendance" class="nav-link <%= page === 'attendance' ? 'active' : '' %>" data-page="attendance">
                        <ion-icon name="calendar-outline"></ion-icon>
                        <span>Attendance</span>
                    </a>
                    <a href="/?page=reports" class="nav-link <%= page === 'reports' ? 'active' : '' %>" data-page="reports">
                        <ion-icon name="bar-chart-outline"></ion-icon>
                        <span>Reports</span>
                    </a>
                    <a href="/?page=projects" class="nav-link <%= page === 'projects' ? 'active' : '' %>" data-page="projects">
                        <ion-icon name="folder-open-outline"></ion-icon>
                        <span>Projects</span>
                    </a>
                    <a href="/?page=institutions" class="nav-link <%= page === 'institutions' ? 'active' : '' %>" data-page="institutions">
                        <ion-icon name="business-outline"></ion-icon>
                        <span>Institutions</span>
                    </a>
                    <a href="/?page=skills" class="nav-link <%= page === 'skills' ? 'active' : '' %>" data-page="skills">
                        <ion-icon name="bulb-outline"></ion-icon>
                        <span>Skills</span>
                    </a>
                    <a href="/?page=history" class="nav-link <%= page === 'history' ? 'active' : '' %>" data-page="history">
                        <ion-icon name="time-outline"></ion-icon>
                        <span>History</span>
                    </a>
                </nav>
            </div>

            <!-- Footer Navigation -->
            <div class="nav-footer-new">
                <a href="/?page=settings" class="nav-link <%= page === 'settings' ? 'active' : '' %>">
                    <ion-icon name="settings-outline"></ion-icon>
                    <span>Settings</span>
                </a>
                <!--<button class="nav-link theme-toggle" id="themeToggle">
                    <ion-icon name="contrast-outline"></ion-icon>
                    <span id="themeText">Dark UI</span>
                </button>-->
                <a href="/logout" class="nav-link logout-link">
                    <ion-icon name="log-out-outline"></ion-icon>
                    <span>Log Out</span>
                </a>
            </div>
        </aside>

        <main class="main-content" id="mainContent">
            <header class="new-page-header">
                <div class="header-title-container">
                    <p class="header-subtitle">
                        <% if (page === 'dashboard') { %> Access your student identification and details <% } 
                           else if (page === 'students') { %> Manage university students <% }
                           else if (page === 'history') { %> View archived alumni records <% }
                           else if (page === 'attendance') { %> Track student attendance <% }
                           else if (page === 'projects') { %> Manage student projects <% }
                           else if (page === 'institutions') { %> Manage affiliated institutions <% }
                           else if (page === 'reports') { %> View and generate reports <% }
                           else if (page === 'settings') { %> Configure application preferences <% }
                           else { %> Manage your university portal <% } %>
                    </p>
                    <h1 class="header-title">
                        <% if (page === 'dashboard') { %>
                            Hello, <span class="highlight"><%= currentUser.username.split(" ")[0] || "User" %></span>
                        <% } else if (page === 'students') { %>
                            Students
                        <% } else { %>
                            <%= page.charAt(0).toUpperCase() + page.slice(1) %>
                        <% } %>
                    </h1>
                </div>

                <div class="header-actions">
                    <a href="#" class="notification-bell">
                        <ion-icon name="notifications-outline"></ion-icon>
                    </a>

                    <div class="profile-avatar">
                        <span class="avatar-text"><%= currentUser.username ? currentUser.username.charAt(0).toUpperCase() : "U" %></span>
                    </div>
                </div>
            </header>

            <div id="loading-spinner" class="loading-spinner" style="display: none;">
                <div class="spinner"></div>
                <p>Loading data...</p>
            </div>

            <%- include('pages/' + page) %>
        </main>
    </div>

    <!-- Notification System -->
    <div id="notification">
        <span id="notification-message"></span>
        <button onclick="hideNotification()">
            <ion-icon name="close-outline"></ion-icon>
        </button>
    </div>

    <!-- Sidebar tooltip -->
    <div id="sidebar-tooltip" class="sidebar-tooltip"></div>

    <!-- Pass current page to JS -->
    <script>window.CURRENT_PAGE = '<%= page %>';</script>

    <!-- ionicons -->
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>

    <!-- Scripts -->
    <script src="/assets/js/home.js"></script>
    <script src="/assets/js/dashboard.js"></script>
    <script src="/assets/js/students.js"></script>
    <script src="/assets/js/attendance.js"></script>
    <script src="/assets/js/settings.js"></script>
    <script src="/assets/js/reports.js"></script>
    <script src="/assets/js/projects.js"></script>
</body>
</html>
